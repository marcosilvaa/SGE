# Copy to .env and replace placeholders. Do not commit real secrets.

# Build/image
PYTHON_VERSION=3.14
REGISTRY=ghcr.io/marcosilvaa/sge
APP_REPLICAS=2

# Swarm/Traefik
STACK_NAME=sge
DOMAIN=<DOMAIN>
ACME_EMAIL=admin@<DOMAIN>
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$replace_with_htpasswd_hash

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-only-for-local-dev
ALLOWED_HOSTS=<DOMAIN>,.<DOMAIN>,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://<DOMAIN>,https://*.<DOMAIN>
DJANGO_USE_WHITENOISE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_DB=sge
POSTGRES_USER=sge
POSTGRES_PASSWORD=change-me-only-for-local-dev
POSTGRES_CONN_MAX_AGE=60

# Local docker compose
APP_PORT=8000
